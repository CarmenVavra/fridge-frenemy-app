APP_NAME="Fridge Frenemy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Vienna
APP_URL=https://fridgefrenemy.caryssa.at

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# netcup: Datenbank im CCP/Plesk anlegen (MariaDB/MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=fridgefrenemy

# netcup: Postfach im CCP/Plesk anlegen. Server steht in den Postfach-Einstellungen (z. B. mxXXXX.netcup.net)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="butler@fridgefrenemy.caryssa.at"
MAIL_FROM_NAME="${APP_NAME}"

# Google Gemini (https://aistudio.google.com/apikey). Ohne Key: eingebaute Sprüche.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENFOODFACTS_USER_AGENT="FridgeFrenemy/1.0 (https://fridgefrenemy.caryssa.at)"

VITE_APP_NAME="${APP_NAME}"
